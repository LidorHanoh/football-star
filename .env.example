# Copy to .env.local and fill in from Supabase: Project Settings -> API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Arabic is hidden until Phase 1.5
NEXT_PUBLIC_ENABLE_ARABIC=false

# Football data API key (api-football.com) — used only by local import scripts
API_FOOTBALL_KEY=
